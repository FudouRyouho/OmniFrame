# ─── Assets binarios ─────────────────────────────────────────────────────────
Project/public/images/*
Project/public/imagenes/*
Project/public/mod-frames/*

# ─── IDEs y herramientas locales ─────────────────────────────────────────────
.vscode/
.editorconfig
docker-compose.yml
Dockerfile
.dockerignore

# ─── Herramientas IA / agentes ───────────────────────────────────────────────
.github/
.claude/settings.local.json

# ─── Archivos de trabajo archivados ──────────────────────────────────────────
docs-archive/

# ─── Dependencias ────────────────────────────────────────────────────────────
node_modules/*
.venv/
**/__pycache__/
**/*.pyc

# ─── Datos y temporales del proyecto ─────────────────────────────────────────
# Fuente activa: upstream pristino de WFCD/warframe-items (post-migración OQ-DATA-16).
# Local, no se sube (data/img pesada); omniframe-items re-cosecha del wiki lo que upstream adelgazó.
warframe-items/
# Banco de lectura: el fork viejo, conservado hasta confirmar estabilidad de omniframe-items (OQ-DATA-16).
warframe-items.backup/
# Excepción: el baseline del audit de sincronización SÍ se trackea (ver docs/data/pipeline/architecture.md §Audit reports).
# Se re-incluye nivel por nivel porque git no desciende en un directorio ignorado por completo.
Project/data/*
!Project/data/audits/
Project/data/audits/*
!Project/data/audits/source-change-report.json
Project/scratch/
docs/data/pipeline/audits/
references/temp/

# ─── Sesiones de trabajo (scratchpad de análisis, no SSoT) ───────────────────
.working/

# ─── Scripts one-off de sesión (patches de un solo uso) ──────────────────────
# (ya cubierto por Project/.gitignore *.local; explícito acá por claridad)
Project/scripts/.local/

# ─── Backups de datos ────────────────────────────────────────────────────────
Project/public/data/bk/*