|
<math>
{
\begin{aligned}
\text{Avg Total Avg DoT on Weak Point} &= \text{Avg Total Avg DoT} \times [\text{Weak Point Multiplier} \times (1 + \text{Weak Point Damage Bonus})]
\end{aligned}
}
