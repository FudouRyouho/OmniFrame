\max{\left( \text{Base Health} \times 1.1,\quad 0.375 \times \left( \text{Base Health} + 900 \right) \times [ 1 + 0.025 \times (x - 15) ] \right)} ,\; & 15 < x \leq 25 \\
\max{\left( \text{Base Health} \times 1.1,\quad 0.375 \times \left( \text{Base Health} + 900 \right) \times [ 1.25 + 0.125 \times (x - 25) ] \right)} ,\; & 25 < x \leq 35 \\
\max{\left( \text{Base Health} \times 1.1,\quad 0.375 \times \left( \text{Base Health} + 900 \right) \times [ 2.5 + \frac{2}{15} \times (x - 35) ] \right)} ,\; & 35 < x \leq 50 \\
