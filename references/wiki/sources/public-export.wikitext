    "criticalMultiplier":1.5,
    "procChance":0.1371429,
    "fireRate":3.3333335,
    "masteryReq":9,
    "productCategory":"Pistols",
    "slot":0,
    "accuracy":13.333333,
    "masteryReq":9,
    "omegaAttenuation":1.1,
    "noise":"ALARMING",
    "trigger":"SEMI",
    "magazineSize":8,
    "reloadTime":1.05,
    "multishot":7
}
</syntaxhighlight>

